          {
            "expr": "mediasoup_workers_total",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "mappings": [],
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "green",
                  "value": null
                }
              ]
            }
          }
        }
      },
      {
        "id": 2,
        "title": "Mediasoup Routers",
        "type": "stat",
        "targets": [
          {
            "expr": "mediasoup_routers_total",
            "refId": "A"
          }
        ]
      },
      {
