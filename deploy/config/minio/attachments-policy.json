{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PrivateAttachmentsAccess",
      "Effect": "Allow",
      "Principal": {
        "AWS": [
          "arn:aws:iam::psynq:user/backend-service"
        ]
      },
      "Action": [
        "s3:PutObject",
        "s3:GetObject",
        "s3:DeleteObject",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::psynq-attachments",
        "arn:aws:s3:::psynq-attachments/*"
      ]
    },
    {
      "Sid": "TenantIsolation",
      "Effect": "Deny",
      "Principal": "*",
      "Action": [
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Resource": [
        "arn:aws:s3:::psynq-attachments/*"
      ],
      "Condition": {
        "StringNotLike": {
          "s3:prefix": [
            "${aws:userid}/*"
          ]
        }
      }
    }
  ]
}
