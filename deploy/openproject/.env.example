# OpenProject Configuration for Psitrix Psynq
# Copy this file to .env and update with your values

# OpenProject Instance Configuration
OPENPROJECT_URL=http://localhost:8080
OPENPROJECT_API_KEY=your_api_key_here

# API Configuration
# The MCP server will connect to this URL
OPENPROJECT_API_KEY_GENERATE_AT=http://localhost:8080/my/access_token

# Admin Credentials (default for fresh install)
OPENPROJECT_ADMIN_USERNAME=admin
OPENPROJECT_ADMIN_PASSWORD=admin
# IMPORTANT: Change these after first login!

# Database Credentials (for reference only - used in docker-compose.yml)
POSTGRES_USER=openproject
POSTGRES_PASSWORD=openproject_password_change_me
POSTGRES_DB=openproject

# Logging Configuration
LOG_LEVEL=INFO

# MCP Server Configuration
MCP_SERVER_HOST=localhost
MCP_SERVER_PORT=8000

# Connection Testing
TEST_CONNECTION_ON_STARTUP=true

# Proxy Configuration (optional - only if needed)
# OPENPROJECT_PROXY=http://proxy.company.com:8080
