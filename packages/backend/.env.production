# Production environment variables
NODE_ENV=production
PORT=3001
HOST=0.0.0.0
CORS_ORIGINS=https://yourdomain.com

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=psynq_user
DB_PASSWORD=mysecretpassword
DB_DATABASE=psynq_db

# Twilio (required for production)
TWILIO_ACCOUNT_SID=your_production_account_sid
TWILIO_API_KEY=your_production_api_key
TWILIO_API_SECRET=your_production_api_secret
TWILIO_TWIML_APP_SID=your_production_twiml_app_sid