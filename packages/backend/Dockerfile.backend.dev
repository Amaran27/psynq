# Use official Node.js LTS image
FROM node:22-bullseye-slim

# Install system dependencies required for mediasoup and native modules
RUN apt-get update && apt-get install -y \
    python3 \
    python3-pip \
    make \
    g++ \
    gcc \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /usr/src/app

# Copy package files for dependency caching
COPY package*.json ./

# Configure npm for better network handling
RUN npm config set registry https://registry.npmjs.org/

# Install dependencies (including mediasoup - it will compile from source)
# This happens at BUILD time, not runtime
RUN npm ci --verbose || npm install --verbose

# Install NestJS CLI globally
RUN npm install -g @nestjs/cli

# Copy application source
COPY . .

# Expose backend port
EXPOSE 3001

# Health check
HEALTHCHECK --interval=10s --timeout=5s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:3001/health || exit 1

# Start development server
CMD ["npm", "run", "start:dev"]