# Backup of Dockerfile.dev

# Backend Dockerfile using official Node.js image with mediasoup compiled from source
FROM node:22-bullseye-slim

# Install system dependencies required for mediasoup and native modules
RUN apt-get update && apt-get install -y \
    python3 \
    python3-pip \
    make \
    g++ \
    gcc \
    build-essential \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /usr/src/app

# Copy root package.json for workspace configuration
COPY package*.json ./

# Copy package.json files for all workspaces
COPY packages/core/package*.json ./packages/core/
COPY packages/backend/package*.json ./packages/backend/

# Configure npm for better network handling in WSL2
RUN npm config set registry https://registry.npmjs.org/

# Install dependencies at BUILD time (this is key to avoiding runtime hangs)
# Install root dependencies and workspace dependencies
RUN npm install --workspace=backend --workspace=@psynq/core \
    --include-workspace-root \
    --verbose \
    --no-audit \
    --no-fund

# Install NestJS CLI and TypeScript globally
RUN npm install -g @nestjs/cli typescript

# Copy core package source and build it
COPY packages/core ./packages/core
WORKDIR /usr/src/app/packages/core
RUN npm run build

# Copy backend source
WORKDIR /usr/src/app
COPY packages/backend ./packages/backend

# Set working directory to backend
WORKDIR /usr/src/app/packages/backend

# Expose backend port
EXPOSE 3001

# Expose debug port
EXPOSE 9229

# Health check
HEALTHCHECK --interval=10s --timeout=5s --start-period=40s --retries=5 \
    CMD curl -f http://127.0.0.1:3001/health || exit 1

# Start development server (no npm install needed - already done!)
CMD ["npm", "run", "start:dev"]