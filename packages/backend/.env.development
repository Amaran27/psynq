# Development environment variables
NODE_ENV=development
PORT=3001
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Authentication
JWT_SECRET=psynq-super-secret-dev-key-2025

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=psynq_user
DB_PASSWORD=mysecretpassword
DB_DATABASE=psynq_db

# Twilio (optional - for development)
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY=
TWILIO_API_SECRET=
TWILIO_TWIML_APP_SID=

# Asterisk
ASTERISK_WEBRTC_URI=ws://localhost:8088/asterisk/ws
ASTERISK_IGNORE_SWAGGER_PROBE=true
SETTINGS_ENCRYPTION_KEY=psynq-encryption-key-32-chars-xyz
