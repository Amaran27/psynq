# Development Dockerfile for frontend (Next.js)
FROM node:22-bullseye

WORKDIR /usr/src/app

RUN apt-get update && apt-get install -y \
    curl \
    procps \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Step 1: Copy manifests
COPY package*.json ./
COPY packages/core/package.json ./packages/core/
COPY packages/web/package.json ./packages/web/

# Step 2: Install dependencies
RUN npm install --workspace=web --workspace=@psynq/core --include-workspace-root --no-audit --no-fund --legacy-peer-deps

# Step 3: Copy source
COPY packages/core ./packages/core
COPY packages/web ./packages/web

# Step 4: Build core
WORKDIR /usr/src/app/packages/core
RUN npm run build

WORKDIR /usr/src/app/packages/web
ENV NODE_ENV=development
ENV NEXT_TELEMETRY_DISABLED=1
EXPOSE 3000

CMD ["npm", "run", "dev"]
