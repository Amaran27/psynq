# Frontend Dockerfile using official Node.js image
FROM node:22-bullseye-slim

# Install curl and other utilities for health checks
RUN apt-get update && apt-get install -y \
    curl \
    procps \
    build-essential \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /usr/src/app

# Copy root package.json for workspace configuration
COPY package*.json ./

# Copy package.json files for workspaces
COPY packages/core/package*.json ./packages/core/
COPY packages/web/package*.json ./packages/web/

# Configure npm for better network handling in WSL2
RUN npm config set registry https://registry.npmjs.org/

# Install dependencies at BUILD time (avoids runtime npm install hangs)
RUN npm install --workspace=web --workspace=@psynq/core \
    --include-workspace-root \
    --no-audit \
    --no-fund \
    --legacy-peer-deps \
    --foreground-scripts \
    --verbose

# Copy core package source and build it
COPY packages/core ./packages/core
WORKDIR /usr/src/app/packages/core
RUN npm run build

# Copy web source
WORKDIR /usr/src/app
COPY packages/web ./packages/web

# Set working directory to web
WORKDIR /usr/src/app/packages/web

# Environment variables
ENV NODE_ENV=development
ENV NEXT_TELEMETRY_DISABLED=1

# Expose frontend port
EXPOSE 3000

# Health check
HEALTHCHECK --interval=10s --timeout=5s --start-period=30s --retries=5 \
    CMD curl -f http://127.0.0.1:3000/ || exit 1

# Start development server (no npm install needed - already done!)
CMD ["npm", "run", "dev"]
